grammar ift6253.hw2.mindmap.MindMap with org.eclipse.xtext.common.Terminals

import "http://www.iro.umontreal.ca/ift6253/hw2/mindmap"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

MindMap:
	'mindmap' title=ID ('(' markers+=Marker (',' markers+=Marker)* ')')?
	topic=CentralTopic
;

// declared once on the map. topics refer to it by 'symbol'
Marker:
	'marker' symbol=Symbol
;

// digits only, kept as text since symbol is an EString
Symbol returns ecore::EString:
	INT
;

// [Marker|Symbol]: a reference to a Marker, written as its 'symbol'
CentralTopic:
	'topic' (marker=[Marker|Symbol])? name=ID
	('includes' '{' maintopics+=MainTopic* '}')?
;

MainTopic:
	'*' (marker=[Marker|Symbol])? name=ID
	('includes' '{' subtopics+=SubTopic* '}')?
;

SubTopic:
	'-' (marker=[Marker|Symbol])? name=ID
	('includes' '{' subsubtopics+=SubTopic* '}')?
;
