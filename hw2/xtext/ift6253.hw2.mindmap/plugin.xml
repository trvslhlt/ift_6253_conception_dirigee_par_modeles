<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>

<!--
-->

<plugin
      name="%pluginName"
      id="ift6253.hw2.mindmap"
      version="1.0.0"
      provider-name="%providerName">

   <requires>
      <import plugin="org.eclipse.core.runtime"/>
      <import plugin="org.eclipse.emf.ecore" export="true"/>
   </requires>

   <runtime>
      <library name=".">
         <export name="*"/>
      </library>
   </runtime>

   <extension point="org.eclipse.emf.ecore.generated_package">
      <!-- @generated MindMap -->
      <package
            uri="http://www.iro.umontreal.ca/ift6253/hw2/mindmap"
            class="ift6253.hw2.mindmap.mindmap.MindMapPackage"
            genModel="model/MindMap.genmodel"/>
   </extension>

</plugin>
