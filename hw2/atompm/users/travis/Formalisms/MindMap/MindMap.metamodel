{
	"types": {
		"MindMap": [
			{
				"name": "title",
				"type": "string",
				"default": "MindMap"
			}
		],
		"Marker": [
			{
				"name": "symbol",
				"type": "string",
				"default": "1"
			}
		],
		"Topic": [
			{
				"name": "name",
				"type": "string",
				"default": "Topic"
			}
		],
		"CentralTopic": [
			{
				"name": "name",
				"type": "string",
				"default": "Topic"
			}
		],
		"MainTopic": [
			{
				"name": "name",
				"type": "string",
				"default": "Topic"
			}
		],
		"SubTopic": [
			{
				"name": "name",
				"type": "string",
				"default": "Topic"
			}
		],
		"markers": [],
		"topic": [],
		"marker": [],
		"maintopics": [],
		"subtopics": [],
		"subsubtopics": []
	},
	"constraints": [
		{
			"name": "noAbstractInstances",
			"event": "pre-create",
			"code": "false",
			"targetType": "Topic"
		},
		{
			"name": "exactly-one-mindmap",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/MindMap']).length == 1"
		},
		{
			"name": "one-parent-per-subtopic",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/SubTopic']).every(function(t) {\n\treturn getNeighbors('<', '/Formalisms/MindMap/MindMap/subtopics', t).length + getNeighbors('<', '/Formalisms/MindMap/MindMap/subsubtopics', t).length == 1;\n})"
		},
		{
			"name": "subtopics-descend-from-a-maintopic",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/SubTopic']).every(function(t) {\n\tvar seen = {};\n\twhile (getAttr('$type', t) == '/Formalisms/MindMap/MindMap/SubTopic') {\n\t\tif (seen[t]) return false;\n\t\tseen[t] = true;\n\t\tvar links = getNeighbors('<', '/Formalisms/MindMap/MindMap/subtopics', t).concat(getNeighbors('<', '/Formalisms/MindMap/MindMap/subsubtopics', t));\n\t\tif (links.length != 1) return false;\n\t\tt = getNeighbors('<', '*', links[0])[0];\n\t}\n\treturn true;\n})"
		},
		{
			"name": "unique-marker-symbols",
			"event": "",
			"targetType": "*",
			"code": "var symbols = getAllNodes(['/Formalisms/MindMap/MindMap/Marker']).map(function(m) { return getAttr('symbol', m); });\nsymbols.length == new Set(symbols).size"
		},
		{
			"name": "non-empty-names",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/CentralTopic', '/Formalisms/MindMap/MindMap/MainTopic', '/Formalisms/MindMap/MindMap/SubTopic']).every(function(t) {\n\treturn getAttr('name', t).trim() != '';\n})"
		}
	],
	"actions": [],
