module ift6253.hw2.mindmap.GenerateMindMap

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."

Workflow {

	// register MindMap.genmodel for the grammar import
	bean = org.eclipse.emf.mwe.utils.StandaloneSetup {
		scanClassPath = true
		platformUri = rootPath
		registerGenModelFile = "platform:/resource/ift6253.hw2.mindmap/model/MindMap.genmodel"
	}

	// emf-gen, since xtext wipes src-gen
	component = org.eclipse.emf.mwe.utils.DirectoryCleaner {
		directory = "${rootPath}/ift6253.hw2.mindmap/emf-gen"
	}
	
	component = org.eclipse.emf.mwe2.ecore.EcoreGenerator {
		genModel = "platform:/resource/ift6253.hw2.mindmap/model/MindMap.genmodel"
		srcPath = "platform:/resource/ift6253.hw2.mindmap/src"
		srcPath = "platform:/resource/ift6253.hw2.mindmap/emf-gen"
	}

	// parser, editor and tests from MindMap.xtext. uses the genmodel, doesn't infer one
	component = XtextGenerator {
		configuration = {
			project = StandardProjectConfig {
				baseName = "ift6253.hw2.mindmap"
				rootPath = rootPath
				runtimeTest = {
					enabled = true
				}
				eclipsePlugin = {
					enabled = true
				}
				createEclipseMetaData = true
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				fileHeader = "/*\n * generated by Xtext \${version}\n */"
				preferXtendStubs = false
			}
		}
		language = StandardLanguage {
			name = "ift6253.hw2.mindmap.MindMap"
			fileExtensions = "mindmap"
			referencedResource = "platform:/resource/ift6253.hw2.mindmap/model/MindMap.genmodel"

			serializer = {
				generateStub = false
			}
			junitSupport = {
				junitVersion = "6"
				generateStub = false
			}
		}
	}
}
