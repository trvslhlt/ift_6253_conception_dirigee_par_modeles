{
	"types": {
		"Tag": [
			{
				"name": "name",
				"type": "string",
				"default": "tag"
			}
		],
		"MindMap": [
			{
				"name": "name",
				"type": "string",
				"default": "mindmap"
			},
			{
				"name": "nextMarker",
				"type": "int",
				"default": 1
			}
		],
		"Topic": [
			{
				"name": "name",
				"type": "string",
				"default": "topic"
			},
			{
				"name": "isDeeper",
				"type": "boolean",
				"default": false
			},
			{
				"name": "isDone",
				"type": "boolean",
				"default": false
			},
			{
				"name": "priority",
				"type": "ENUM(NONE,HIGH,MEDIUM,LOW)",
				"default": "NONE"
			},
			{
				"name": "description",
				"type": "string",
				"default": ""
			},
			{
				"name": "color",
				"type": "string",
				"default": ""
			},
			{
				"name": "level",
				"type": "int",
				"default": 0
			},
			{
				"name": "effectivelyDone",
				"type": "boolean",
				"default": false
			},
			{
				"name": "computed",
				"type": "boolean",
				"default": false
			},
			{
				"name": "marker",
				"type": "int",
				"default": 0
			},
			{
				"name": "nextMarker",
				"type": "int",
				"default": 1
			}
		],
		"roots": [],
		"children": [],
		"related": [],
		"tagged": [],
		"hasTag": []
	},
	"constraints": [
		{
			"name": "exactly-one-mindmap",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/MindMap']).length == 1"
		},
		{
			"name": "unique-topic-names",
			"event": "",
			"targetType": "*",
			"code": "var names = getAllNodes(['/Formalisms/MindMap/MindMap/Topic']).map(function(t) { return getAttr('name', t); });\nnames.length == new Set(names).size"
		},
		{
			"name": "unique-tag-names",
			"event": "",
			"targetType": "*",
			"code": "var names = getAllNodes(['/Formalisms/MindMap/MindMap/Tag']).map(function(t) { return getAttr('name', t); });\nnames.length == new Set(names).size"
		},
		{
			"name": "valid-topic-colors",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/Topic']).every(function(t) {\n\tvar color = getAttr('color', t);\n\treturn color == '' || /^#[0-9a-fA-F]{6}$/.test(color);\n})"
		},
		{
			"name": "no-deeper-at-root",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/Topic']).every(function(t) {\n\treturn getNeighbors('in', '/Formalisms/MindMap/MindMap/roots', t).length == 0 || !getAttr('isDeeper', t);\n})"
		},
		{
			"name": "no-self-relation",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/related']).every(function(l) {\n\treturn getNeighbors('in', '*', l)[0] != getNeighbors('out', '*', l)[0];\n})"
		},
		{
			"name": "topics-form-a-tree",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/Topic']).every(function(t) {\n\tvar seen = {};\n\twhile (!seen[t]) {\n\t\tseen[t] = true;\n\t\tvar rootLinks = getNeighbors('in', '/Formalisms/MindMap/MindMap/roots', t),\n\t\t\t childLinks = getNeighbors('in', '/Formalisms/MindMap/MindMap/children', t);\n\t\tif (rootLinks.length + childLinks.length != 1) return false;\n\t\tif (rootLinks.length == 1) return true;\n\t\tt = getNeighbors('in', '*', childLinks[0])[0];\n\t}\n\treturn false;\n})"
		},
		{
			"name": "tags-belong-to-the-map",
			"event": "",
			"targetType": "*",
			"code": "getAllNodes(['/Formalisms/MindMap/MindMap/Tag']).every(function(t) {\n\treturn getNeighbors('in', '/Formalisms/MindMap/MindMap/hasTag', t).length == 1;\n})"
		}
	],
	"actions": [],
