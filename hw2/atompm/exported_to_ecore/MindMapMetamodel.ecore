<?xml version="1.0" encoding="UTF-8"?> 
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="MindMap" nsURI="http://MindMap" nsPrefix="MindMap"> 
  <eClassifiers xsi:type="ecore:EClass" name="Marker"> 
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="symbol" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="1"/> 
  </eClassifiers> 
  <eClassifiers xsi:type="ecore:EClass" name="MindMap"> 
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="MindMap"/> 
    <eStructuralFeatures xsi:type="ecore:EReference" name="markers" upperBound="Infinity" eType="#//Marker"/> 
    <eStructuralFeatures xsi:type="ecore:EReference" name="topic" lowerBound="1" eType="#//CentralTopic"/> 
  </eClassifiers> 
  <eClassifiers xsi:type="ecore:EClass" name="Topic" abstract="true"> 
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" defaultValueLiteral="Topic"/> 
    <eStructuralFeatures xsi:type="ecore:EReference" name="marker" eType="#//Marker"/> 
  </eClassifiers> 
  <eClassifiers xsi:type="ecore:EClass" name="CentralTopic" eSuperTypes="#//Topic"> 
    <eStructuralFeatures xsi:type="ecore:EReference" name="maintopics" upperBound="Infinity" eType="#//MainTopic"/> 
  </eClassifiers> 
  <eClassifiers xsi:type="ecore:EClass" name="MainTopic" eSuperTypes="#//Topic"> 
    <eStructuralFeatures xsi:type="ecore:EReference" name="subtopics" upperBound="Infinity" eType="#//SubTopic"/> 
  </eClassifiers> 
  <eClassifiers xsi:type="ecore:EClass" name="SubTopic" eSuperTypes="#//Topic"> 
    <eStructuralFeatures xsi:type="ecore:EReference" name="subsubtopics" eType="#//SubTopic"/> 
  </eClassifiers> 
</ecore:EPackage>