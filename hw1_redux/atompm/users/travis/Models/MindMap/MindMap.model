			},
			"12": {
				"$type": "/Formalisms/__LanguageSyntax__/SimpleClassDiagram/SimpleClassDiagram/Inheritance"
			},
			"13": {
				"$type": "/Formalisms/__LanguageSyntax__/SimpleClassDiagram/SimpleClassDiagram/Inheritance"
			},
			"14": {
				"$type": "/Formalisms/__LanguageSyntax__/SimpleClassDiagram/SimpleClassDiagram/Inheritance"
			},
			"15": {
				"name": {
					"type": "string",
					"value": "exactly-one-mindmap"
				},
				"event": {
					"type": "$EVENT",
					"value": ""
				},
				"code": {
					"type": "code",
					"value": "getAllNodes(['/Formalisms/MindMap/MindMap/MindMap']).length == 1"
				},
				"$type": "/Formalisms/__LanguageSyntax__/SimpleClassDiagram/SimpleClassDiagram/GlobalConstraint"
			},
			"16": {
				"name": {
					"type": "string",
					"value": "one-parent-per-subtopic"
				},
				"event": {
					"type": "$EVENT",
					"value": ""
				},
				"code": {
					"type": "code",
					"value": "getAllNodes(['/Formalisms/MindMap/MindMap/SubTopic']).every(function(t) {\n\treturn getNeighbors('<', '/Formalisms/MindMap/MindMap/subtopics', t).length + getNeighbors('<', '/Formalisms/MindMap/MindMap/subsubtopics', t).length == 1;\n})"
				},
				"$type": "/Formalisms/__LanguageSyntax__/SimpleClassDiagram/SimpleClassDiagram/GlobalConstraint"
			},
			"17": {
				"name": {
					"type": "string",
					"value": "subtopics-descend-from-a-maintopic"
				},
				"event": {
					"type": "$EVENT",
					"value": ""
				},
				"code": {
					"type": "code",
					"value": "getAllNodes(['/Formalisms/MindMap/MindMap/SubTopic']).every(function(t) {\n\tvar seen = {};\n\twhile (getAttr('$type', t) == '/Formalisms/MindMap/MindMap/SubTopic') {\n\t\tif (seen[t]) return false;\n\t\tseen[t] = true;\n\t\tvar links = getNeighbors('<', '/Formalisms/MindMap/MindMap/subtopics', t).concat(getNeighbors('<', '/Formalisms/MindMap/MindMap/subsubtopics', t));\n\t\tif (links.length != 1) return false;\n\t\tt = getNeighbors('<', '*', links[0])[0];\n\t}\n\treturn true;\n})"
				},
				"$type": "/Formalisms/__LanguageSyntax__/SimpleClassDiagram/SimpleClassDiagram/GlobalConstraint"
			},
			"18": {
				"name": {
					"type": "string",
					"value": "unique-marker-symbols"
				},
				"event": {
					"type": "$EVENT",
					"value": ""
				},
				"code": {
					"type": "code",
					"value": "var symbols = getAllNodes(['/Formalisms/MindMap/MindMap/Marker']).map(function(m) { return getAttr('symbol', m); });\nsymbols.length == new Set(symbols).size"
				},
				"$type": "/Formalisms/__LanguageSyntax__/SimpleClassDiagram/SimpleClassDiagram/GlobalConstraint"
			},
			"19": {
				"name": {
					"type": "string",
					"value": "non-empty-names"
				},
				"event": {
					"type": "$EVENT",
					"value": ""
				},
				"code": {
					"type": "code",
					"value": "getAllNodes(['/Formalisms/MindMap/MindMap/CentralTopic', '/Formalisms/MindMap/MindMap/MainTopic', '/Formalisms/MindMap/MindMap/SubTopic']).every(function(t) {\n\treturn getAttr('name', t).trim() != '';\n})"
				},
				"$type": "/Formalisms/__LanguageSyntax__/SimpleClassDiagram/SimpleClassDiagram/GlobalConstraint"
			}
		},
